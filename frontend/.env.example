# Base URL for the Python FastAPI Object Detection Backend
VITE_API_BASE_URL=http://127.0.0.1:8000

# Initial detection confidence threshold (0.05 - 0.95)
VITE_DEFAULT_CONFIDENCE=0.35

# Frame upload interval in milliseconds (recommended: 200 - 300)
VITE_CAPTURE_INTERVAL_MS=250

# Maximum frame width uploaded to backend (preserves aspect ratio)
VITE_MAX_UPLOAD_WIDTH=640
