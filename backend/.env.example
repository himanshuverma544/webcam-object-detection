# Application Settings
APP_NAME="YOLO11 Real-Time Object Detection API"
APP_VERSION="1.0.0"
HOST="127.0.0.1"
PORT=8000
LOG_LEVEL="INFO"

# CORS Allowed Origins (comma-separated)
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173"

# AI / YOLO11 Inference Settings
YOLO_MODEL_PATH="yolo11n.pt"
DEFAULT_CONFIDENCE=0.35
IOU_THRESHOLD=0.45
MAX_DETECTIONS=100
DEVICE="auto"

# Upload Validation Settings
MAX_UPLOAD_SIZE_BYTES=10485760

# Resend Email API Settings (Recommended)
RESEND_API_KEY="re_your_api_key_here"
RESEND_FROM_EMAIL="Webcam Detection <onboarding@resend.dev>"
DEFAULT_RECIPIENT_EMAIL="your-email@example.com"

# Gemini AI Copilot Settings
GEMINI_API_KEY="your_gemini_api_key_here"
GEMINI_MODEL="gemini-3.1-flash-lite"
